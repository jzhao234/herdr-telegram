# Primary Telegram Bot token from @BotFather (receives default workspaces, or all workspaces when single-bot)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram chat ID (leave blank initially and send /start to the bot to discover your ID)
TELEGRAM_CHAT_ID=

# Optional second @BotFather token for Production Support / ops alerts (or define N named bots in config.toml!)
TELEGRAM_PROD_BOT_TOKEN=

# Optional chat ID override for TELEGRAM_PROD_BOT_TOKEN (defaults to TELEGRAM_CHAT_ID for private 1:1 chats)
TELEGRAM_PROD_CHAT_ID=

# Optional comma-separated workspace names/globs routed to TELEGRAM_PROD_BOT_TOKEN when config.toml [[routes]] is unset
# (default: prod-support,prodsupport,production-support,on-duty,onduty,oncall,incident-response)
HERDR_PROD_WORKSPACES=

# Deliver routine all-green Prod Support completion digests silently (disable_notification=true) while
# P1/P2 findings, PR updates, Needs your attention items, and Blocked alerts still buzz normally (default: 1)
HERDR_SILENT_PROD_GREEN=1

# Poll interval in seconds for checking Herdr agent states (default: 2.0)
HERDR_POLL_INTERVAL=2.0

# Seconds an agent in [defaults] must stay done/idle before texting a completion digest (default: 90;
# direct replies to Telegram messages skip this wait, and per-route overrides can be set in config.toml)
HERDR_IDLE_DELAY_SECONDS=90

# Seconds an agent must stay blocked on a prompt before texting a blocked alert (default: 30)
HERDR_BLOCKED_DELAY_SECONDS=30

# Number of terminal lines to read for /read (default: 120) and completion digests (default: 180)
HERDR_READ_LINES=120
HERDR_SUMMARY_READ_LINES=180

# Summarizer backend for longer completed turns:
#   auto       - auto-detects installed CLI (claude, codex, gemini, agy) or API key, else clean HTML fallback
#   off        - disable LLM summarization and format terminal output directly as clean HTML
#   claude     - local Claude Code CLI (default model: haiku)
#   codex      - local OpenAI Codex CLI in ephemeral read-only sandbox
#   gemini     - local Gemini CLI in read-only plan mode (default model: gemini-2.5-flash)
#   agy        - local Antigravity CLI in tool-denied sandbox (default model: gemini-2.5-flash)
#   openai     - OpenAI or any OpenAI-compatible API such as OpenRouter/Groq/Together (default model: gpt-4.1-mini)
#   ollama     - local Ollama HTTP server at http://127.0.0.1:11434/v1 (default model: llama3.2)
#   anthropic  - Anthropic Messages API (default model: claude-haiku-4-5)
#   gemini-api - Google Gemini REST API (default model: gemini-2.5-flash)
HERDR_SUMMARY_PROVIDER=auto

# Optional model override (or shorthand like claude:haiku, openai:gpt-4.1-mini, ollama:qwen2.5:7b, or off)
HERDR_SUMMARY_MODEL=

# Optional API key and base URL for HTTP summary providers (openai, ollama, anthropic, gemini-api).
# Falls back to OPENAI_API_KEY, ANTHROPIC_API_KEY, or GEMINI_API_KEY when unset.
HERDR_SUMMARY_API_KEY=
HERDR_SUMMARY_API_URL=

# Minimum cleaned character count before invoking the LLM summarizer (default: 180)
HERDR_SUMMARY_MIN_CHARS=180

# Default agent for /spawn when --agent is omitted (any Herdr agent kind or custom [agents.<name>] alias; default: claude)
HERDR_DEFAULT_AGENT=claude

# Optional colon-separated root directories searched by /spawn
# (auto-discovers existing ~/projects, ~/code, ~/src, ~/repos, ~/dev when empty)
HERDR_SPAWN_ROOTS=

# Startup readiness timeout in milliseconds for /spawn (3001..60000, default: 30000)
HERDR_SPAWN_TIMEOUT_MS=30000
